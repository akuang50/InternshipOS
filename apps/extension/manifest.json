{
  "manifest_version": 3,
  "name": "InternshipOS",
  "version": "0.2.0",
  "description": "Fill internship applications from your InternshipOS profile. It never submits.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://internshipos.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "InternshipOS"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*"
      ],
      "js": ["config.js", "fill.js", "content.js"],
      "css": ["panel.css"]
    }
  ]
}
