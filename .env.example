# Local development persists to apps/web/.data (file store + private uploads).
# Never point local development at the production Supabase project.
# On Vercel, set secrets in the dashboard per environment (Production, Preview, Development).
# Do not prefix the service role, AI key, or Stripe secret with NEXT_PUBLIC_.

# Public site URL. Launch on the free Vercel hostname; a custom domain is optional later.
# Production example: https://internshipos.vercel.app
# Dev:
NEXT_PUBLIC_APP_URL=http://localhost:3000

# When Supabase Auth is connected, register this same origin as the Site URL
# and as a redirect URL (https://internshipos.vercel.app/** in production,
# http://localhost:3000/** in dev). Do not register a custom domain until you add one.

# Optional model provider. Server-side only. When unset, drafts use the
# rules engine and the UI says so — it does not pretend a model wrote them.
AI_API_KEY=
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_STRONG=gpt-4o
AI_MONTHLY_CAP=40
AI_BASE_URL=https://api.openai.com/v1

# Optional. Project keys are public by design; service secrets are not listed here.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=

# Production adapter (schema in supabase/migrations). Use a different Supabase
# project for dev, staging, and production. Service role is server-only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Add Stripe only when charging. Webhook secrets stay server-side.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
